<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_equipment_view_form_inherit_bauhof" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit.bauhof</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="x_vehicle_id"/>
                <field name="x_uvv_next"/>
            </field>
        </field>
    </record>

    <record id="hr_equipment_view_tree_inherit_bauhof" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.inherit.bauhof</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="x_vehicle_id" optional="show"/>
                <field name="x_uvv_next" optional="show"/>
            </field>
        </field>
    </record>
</odoo>